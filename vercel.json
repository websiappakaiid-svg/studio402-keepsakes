{
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/loveos.html"
    },
    {
      "source": "/editor",
      "destination": "/editor-loveos.html"
    },
    {
      "source": "/editor-loveos",
      "destination": "/editor-loveos.html"
    },
    {
      "source": "/admin",
      "destination": "/api"
    },
    {
      "source": "/admin.html",
      "destination": "/api"
    },
    {
      "source": "/v/:slug*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}