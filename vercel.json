{
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/loveos.html" },
    { "source": "/editor", "destination": "/editor-loveos.html" },
    { "source": "/editor-loveos", "destination": "/editor-loveos.html" },
    { "source": "/admin", "destination": "/api?route=admin" },
    { "source": "/admin.html", "destination": "/api?route=admin" },
    { "source": "/v/:slug*", "destination": "/api?slug=:slug*" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}
